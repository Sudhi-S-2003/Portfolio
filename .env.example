# Chat backend used by netlify/functions/chat.ts.
# Production: set these four in Netlify > Site configuration > Environment variables (never in code).
# Local dev: copy this file to .env.local (git-ignored) and fill in the key and secret.
# Without them the function answers "misconfigured" and messages stay queued for the chat; on the deployed site the
# email copy (Netlify Forms) still reaches you.
CHAT_API_BASE=https://nutrify-backend-z5vr.onrender.com
CHAT_API_KEY=
CHAT_API_SECRET=
CHAT_FRONTEND_BASE=https://nutrify-frontend.onrender.com

# Local dev only: Netlify Forms (the email copy) does not exist on localhost, so by default the dev server answers
# "not available" and the page shows what a visitor would see if it were down. Set to 1 to simulate success instead.
LOCAL_FORMS_ACCEPT=0
